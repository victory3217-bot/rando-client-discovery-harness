{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rando/client-discovery-harness/schemas/client_candidate.schema.json",
  "title": "Client Discovery Harness - Client Candidate",
  "description": "A prospect found by aligning capability, solution, market opportunity, customer problem and purchasing possibility. Three different 'why' questions have three different answers: source_ids says why this organization is in the pool at all (the sources that name it, which is what makes an invented company name unable to be stored); each FitAssessment's own source_ids and finding_ids say why that criterion got its level; key_issue_ids says which decisions from the diagnosis sent us looking. Fit levels are ordinal enums, never numbers, and the priority band is computed by an explicit rule table rather than by a weighted score.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "client_id",
    "project_id",
    "client_name",
    "country",
    "industry",
    "discovery_rationale",
    "source_ids",
    "market_scope",
    "finding_ids",
    "fit",
    "priority",
    "status",
    "schema_version"
  ],
  "$defs": {
    "fitLevel": {
      "type": "string",
      "enum": [
        "STRONG",
        "MODERATE",
        "WEAK",
        "UNKNOWN",
        "EVIDENCE_NEEDED"
      ]
    },
    "fitAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion",
        "level"
      ],
      "properties": {
        "criterion": {
          "type": "string",
          "enum": [
            "PROBLEM_FIT",
            "SOLUTION_FIT",
            "CAPABILITY_FIT",
            "MARKET_ATTRACTIVENESS",
            "PURCHASING_POTENTIAL",
            "ACCESSIBILITY",
            "COMPETITIVE_SITUATION",
            "EVIDENCE_QUALITY"
          ]
        },
        "level": {
          "$ref": "#/$defs/fitLevel",
          "description": "All eight criteria point the same way: STRONG means favourable for business development. Strong competition is WEAK, not STRONG."
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500,
          "description": "An interpretation, capped so that a passage cannot be pasted in and become a second store of document text."
        },
        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "properties": {
    "client_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string",
      "minLength": 1
    },
    "country": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "discovery_rationale": {
      "type": "string",
      "minLength": 1,
      "description": "What of ours can be sold to which problem of theirs. A name without this is an industry list entry, not a candidate."
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Discovery and identity provenance only: the sources in which this organization was actually named. Not a bucket for every piece of criterion evidence - that lives on each FitAssessment. Required, because a name nothing mentions has no source to cite."
    },
    "market_scope": {
      "type": "string",
      "enum": [
        "DOMESTIC",
        "INTERNATIONAL"
      ]
    },
    "finding_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "key_issue_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Which decisions from the diagnosis sent us looking for an organization like this."
    },
    "fit": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/fitAssessment"
      },
      "description": "All eight criteria, always. A criterion nobody looked at says UNKNOWN rather than being absent."
    },
    "priority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "band",
        "reason_codes"
      ],
      "properties": {
        "band": {
          "type": "string",
          "enum": [
            "P1",
            "P2",
            "P3",
            "DEFERRED",
            "UNKNOWN"
          ],
          "description": "A review band, not an instruction to sell. Computed by rule, never by a model and never by a weighted score."
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "CORE_FIT_POSITIVE",
              "CORE_FIT_WEAK",
              "COMMERCIAL_SIGNAL_CONFIRMED",
              "PURCHASE_EVIDENCE_NEEDED",
              "ACCESS_EVIDENCE_NEEDED",
              "COMPETITIVE_BARRIER",
              "INSUFFICIENT_EVIDENCE",
              "SNIPPET_ONLY_LIMITATION",
              "IDENTITY_VERIFICATION_NEEDED"
            ]
          },
          "description": "Codes, not sentences. locales/*.json renders what a person reads."
        },
        "missing_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "identity": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "legal_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "domain": {
          "type": [
            "string",
            "null"
          ]
        },
        "organization_identifier": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "description": "What is known about which legal entity this is. Every field stays null when the evidence does not say - a guessed domain looks like a fact."
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "SCREENED",
        "PRIORITIZED",
        "ANALYZED",
        "PROPOSAL_DRAFTED",
        "DEFERRED",
        "REJECTED"
      ]
    },
    "lang": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    }
  }
}
