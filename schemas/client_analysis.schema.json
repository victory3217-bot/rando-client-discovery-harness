{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rando/client-discovery-harness/schemas/client_analysis.schema.json",
  "title": "Client Discovery Harness - Client Analysis",
  "description": "Deep analysis of one prioritised client using MN03/MN04/MN05/MN06 only. MN02 and MN07 diagnose the company rather than the client and are not repeated per client. When evidence is empty, missing_evidence must say what needs to be found - enforced by core/evidence.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["analysis_id", "project_id", "client_id", "client_name", "country", "industry", "evidence", "missing_evidence", "sales_priority", "mn_basis", "schema_version"],
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id"],
      "properties": {
        "finding_id": { "type": "string" },
        "source_id": { "type": ["string", "null"] },
        "note": { "type": ["string", "null"] }
      }
    }
  },
  "properties": {
    "analysis_id": { "type": "string" },
    "project_id": { "type": "string" },
    "client_id": { "type": "string" },
    "client_name": { "type": "string", "minLength": 1 },
    "country": { "type": "string" },
    "industry": { "type": "string" },

    "company_summary": { "type": ["string", "null"] },
    "business_issue": { "type": ["string", "null"] },
    "user": { "type": ["string", "null"], "description": "MN03: who uses it." },
    "buyer": { "type": ["string", "null"], "description": "MN03: who pays." },
    "decision_maker": { "type": ["string", "null"], "description": "MN03: who approves." },
    "problem": { "type": ["string", "null"] },
    "problem_severity": { "type": ["string", "null"] },

    "current_solution": { "type": ["string", "null"] },
    "competitor": { "type": ["string", "null"] },
    "substitute": { "type": ["string", "null"] },
    "kbf": { "type": ["string", "null"], "description": "MN04: key buying factor." },
    "our_solution": { "type": ["string", "null"] },
    "value_proposition": { "type": ["string", "null"] },
    "competitive_advantage": { "type": ["string", "null"] },

    "sales_access_route": { "type": ["string", "null"], "description": "MN05: how we actually reach the buyer." },
    "potential_partner": { "type": ["string", "null"] },

    "pricing_implication": { "type": ["string", "null"], "description": "MN06: what this client implies for price, margin and revenue model. Not a price." },

    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" } },
    "missing_evidence": { "type": "array", "items": { "type": "string" } },
    "sales_priority": { "type": "string", "enum": ["P1", "P2", "P3", "DEFERRED", "UNKNOWN"] },
    "market_scope": { "type": "string", "enum": ["DOMESTIC", "INTERNATIONAL"] },
    "international": {
      "description": "Filled only when market_scope is INTERNATIONAL. Kept as its own object so a domestic project never carries twelve empty fields.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [],
      "properties": {
        "local_buyer": { "type": ["string", "null"] },
        "local_competitor": { "type": ["string", "null"] },
        "regulation": { "type": ["string", "null"] },
        "certification": { "type": ["string", "null"] },
        "tariff": { "type": ["string", "null"] },
        "logistics": { "type": ["string", "null"] },
        "exchange_rate": { "type": ["string", "null"] },
        "local_partner": { "type": ["string", "null"] },
        "distribution_structure": { "type": ["string", "null"] },
        "local_price": { "type": ["string", "null"] },
        "purchasing_power": { "type": ["string", "null"] },
        "entry_barrier": { "type": ["string", "null"] }
      }
    },
    "mn_basis": { "type": "array", "items": { "type": "string" } },
    "lang": { "type": "string" },
    "created_at": { "type": "string" },
    "schema_version": { "type": "string" }
  }
}
