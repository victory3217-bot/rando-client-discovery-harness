{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/victory3217-bot/rando-client-discovery-harness/schemas/client_analysis.schema.json",
  "title": "ClientAnalysis",
  "description": "Deep analysis of one human-selected client, as nineteen evidence-backed claims. Carries no priority: the band lives on ClientCandidate.priority and is decided by an explicit rule from the fit assessments. A second priority here would give one client two answers with nothing to say which is current.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysis_id",
    "project_id",
    "client_id",
    "client_name",
    "country",
    "industry",
    "our_solution",
    "claims",
    "international_claims",
    "finding_ids",
    "missing_evidence",
    "mn_basis",
    "schema_version"
  ],
  "$defs": {
    "analysisClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension"
      ],
      "properties": {
        "dimension": {
          "type": "string",
          "enum": [
            "USER",
            "BUYER",
            "DECISION_MAKER",
            "BUDGET_OWNER",
            "PROBLEM",
            "PROBLEM_SEVERITY",
            "CURRENT_WORKAROUND",
            "KBF",
            "CURRENT_SOLUTION",
            "COMPETITOR",
            "SUBSTITUTE",
            "VALUE_PROPOSITION",
            "COMPETITIVE_ADVANTAGE",
            "SALES_ACCESS_ROUTE",
            "PARTNER",
            "VALUE_DRIVER",
            "PRICE_SENSITIVITY",
            "BUDGET_EVIDENCE",
            "PROCUREMENT_CONTEXT"
          ]
        },
        "statement": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500,
          "description": "An interpretation of the evidence, never a copy of it. Null when the evidence does not settle this dimension."
        },
        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The only reference stored. Sources are reached through these findings - see core.analysis.source_ids_for."
        },
        "missing_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_type": {
          "type": "string",
          "enum": [
            "FACT",
            "INFERENCE",
            "ASSUMPTION",
            "MISSING_EVIDENCE"
          ],
          "description": "Derived from the dimension's kind, not copied from the supporting findings: joining three facts into a conclusion produces an inference."
        },
        "confidence": {
          "type": "string",
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW",
            "UNKNOWN"
          ]
        },
        "framework_basis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "organization_name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Only once verified against the cited passage by core.client.verify."
        },
        "access_route": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "KNOWN_CHANNEL",
            "PARTNER",
            "PROCUREMENT_PORTAL",
            "BUYER_CONTACT_ROUTE",
            "INDUSTRY_EVENT",
            "PUBLIC_TENDER",
            null
          ],
          "description": "SALES_ACCESS_ROUTE only."
        }
      }
    },
    "internationalClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension"
      ],
      "properties": {
        "dimension": {
          "type": "string",
          "enum": [
            "LOCAL_BUYING_STRUCTURE",
            "REGULATION",
            "CERTIFICATION",
            "TARIFF",
            "LOGISTICS",
            "CURRENCY_FX",
            "ENTRY_BARRIER",
            "LOCAL_PARTNER_REQUIREMENT"
          ]
        },
        "statement": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500,
          "description": "An interpretation of the evidence, never a copy of it. Null when the evidence does not settle this dimension."
        },
        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The only reference stored. Sources are reached through these findings - see core.analysis.source_ids_for."
        },
        "missing_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_type": {
          "type": "string",
          "enum": [
            "FACT",
            "INFERENCE",
            "ASSUMPTION",
            "MISSING_EVIDENCE"
          ],
          "description": "Derived from the dimension's kind, not copied from the supporting findings: joining three facts into a conclusion produces an inference."
        },
        "confidence": {
          "type": "string",
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW",
            "UNKNOWN"
          ]
        },
        "framework_basis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "properties": {
    "analysis_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string",
      "description": "The ClientCandidate a person selected for analysis."
    },
    "client_name": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "our_solution": {
      "type": "string",
      "description": "Supplied by the caller, never produced by a model. Asking a model what we sell is asking it to invent a product."
    },
    "claims": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "items": {
        "$ref": "#/$defs/analysisClaim"
      },
      "description": "Exactly one per AnalysisDimension. A dimension nobody could settle says so rather than being absent."
    },
    "international_claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/internationalClaim"
      },
      "description": "Empty unless market_scope is INTERNATIONAL."
    },
    "market_scope": {
      "type": "string",
      "enum": [
        "DOMESTIC",
        "INTERNATIONAL"
      ]
    },
    "finding_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Derived: the sorted union of every claim's finding_ids."
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Derived: the sorted union of every claim's missing_evidence."
    },
    "mn_basis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lang": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    }
  }
}
